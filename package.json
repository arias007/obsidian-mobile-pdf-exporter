{
  "name": "obsidian-mobile-pdf-exporter",
  "version": "0.6.1",
  "description": "Export Obsidian content to PDF, DOCX, PPTX, PNG, and self-contained HTML.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
